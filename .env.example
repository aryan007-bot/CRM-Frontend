# Frontend environment template. Copy to .env.local (git-ignored) for local dev.
#
# Only NEXT_PUBLIC_* variables reach the browser. Anything containing SECRET,
# PASSWORD, TOKEN, DATABASE or PRIVATE_KEY must NEVER be prefixed NEXT_PUBLIC_,
# because that would ship it to every visitor.

# Base URL of the FastAPI backend, as reached from the user's browser.
# Local development:
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000"
# Production example:
# NEXT_PUBLIC_API_BASE_URL="https://api.your-domain.com"

# Phase 4 control plane: set to "true" ONLY for local development without a
# Phase 4 backend. Serves synthetic demo fixtures for the infrastructure
# screens. Never enable in production — the real endpoints are always called
# when this is unset or "false".
# NEXT_PUBLIC_USE_MOCKS="true"

# Optional: label shown in the control-plane header (e.g. "Production").
# Derived from NODE_ENV when unset.
# NEXT_PUBLIC_CONTROL_PLANE_ENV="Production"

# Optional: Next.js server settings (not exposed to the browser).
# NODE_ENV="production"
# PORT=3000
