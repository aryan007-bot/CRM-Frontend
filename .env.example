# Frontend environment template. Copy to .env.local (git-ignored) for local dev.
#
# Only NEXT_PUBLIC_* variables reach the browser. Anything containing SECRET,
# PASSWORD, TOKEN, DATABASE or PRIVATE_KEY must NEVER be prefixed NEXT_PUBLIC_,
# because that would ship it to every visitor.

# Base URL of the FastAPI backend, as reached from the user's browser.
# Local development:
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000"
# Production example:
# NEXT_PUBLIC_API_BASE_URL="https://api.your-domain.com"

# Optional: Next.js server settings (not exposed to the browser).
# NODE_ENV="production"
# PORT=3000
